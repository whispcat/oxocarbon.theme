# Oxocarbon colors for dunst
# For more configuration options see https://github.com/dunst-project/dunst/blob/master/dunstrc

[urgency_low]
    background = "#fafafa"
    foreground = "#37474f"
    frame_color = "#37474f"

[urgency_normal]
    background = "#ffffff"
    foreground = "#37474f"
    frame_color = "#37474f"

[urgency_critical]
    background = "#f2f2f2"
    foreground = "#ff6f00"
    frame_color = "#ff6f00"
